    "history": {
        "v": 2,
        "now": "The Llama family has 8 versions in our catalog, with the first released on 2024-07-23 and the newest, Llama Guard 4 12B, released on 2025-04-30. The family spans model sizes from 1 billion to 2 trillion parameters and includes both foundation and instruction fine-tuned versions. Meta has described Llama as open source, a label that has drawn criticism from the Open Source Initiative.",
        "basis": "wikipedia",
        "entries": [
            {
                "date": "2023-02-24",
                "text": "Meta announced the first Llama model, a foundation model whose weights were offered only through an application process for researchers."
            },
            {
                "date": "2023-02-24",
                "text": "Unauthorized copies of the first Llama model were shared through BitTorrent after its limited release."
            },
            {
                "date": "2025-04",
                "text": "Meta released Llama 4, the latest version of the family."
            },
            {
